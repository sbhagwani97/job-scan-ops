    "web":  [
                {
                    "name":  "LinkedIn",
                    "urlTemplate":  "https://www.linkedin.com/jobs/search/?keywords={role}\u0026location={location}\u0026f_TPR=r{seconds}",
                    "notes":  "Login-walled and hostile to scraping. Best effort; Firecrawl works better than WebFetch."
                },
                {
                    "name":  "Indeed",
                    "urlTemplate":  "https://www.indeed.com/jobs?q={role}\u0026l={location}\u0026fromage={days}",
                    "notes":  "Often blocks bots. Change the domain for your country (de.indeed.com, uk.indeed.com, ...)."
                },
                {
                    "name":  "Glassdoor",
                    "urlTemplate":  "https://www.glassdoor.com/Job/jobs.htm?sc.keyword={role}\u0026locKeyword={location}\u0026fromAge={days}",
                    "notes":  "Login-walled. Needs Firecrawl."
                },
                {
                    "name":  "Wellfound",
                    "urlTemplate":  "https://wellfound.com/role/{role_slug}",
                    "notes":  "Startup jobs. Needs Firecrawl."
                },
                {
                    "name":  "Work at a Startup (YC)",
                    "urlTemplate":  "https://www.workatastartup.com/jobs?query={role}",
                    "notes":  "Y Combinator companies."
                },
                {
                    "name":  "Otta / Welcome to the Jungle",
                    "urlTemplate":  "https://www.welcometothejungle.com/en/jobs?query={role}\u0026aroundQuery={location}",
                    "notes":  "Europe-focused tech jobs."
                },
                {
                    "name":  "StepStone",
                    "urlTemplate":  "https://www.stepstone.de/jobs/{role_slug}/in-{location_slug}?fromage={days}",
                    "notes":  "Germany / Europe. Change the domain for your country."
                },
                {
                    "name":  "XING",
                    "urlTemplate":  "https://www.xing.com/jobs/search?keywords={role}\u0026location={location}",
                    "notes":  "DACH region."
                },
                {
                    "name":  "Naukri",
                    "urlTemplate":  "https://www.naukri.com/{role_slug}-jobs-in-{location_slug}",
                    "notes":  "India."
                },
                {
                    "name":  "Built In",
                    "urlTemplate":  "https://builtin.com/jobs?search={role}",
                    "notes":  "US tech hubs."
                },
                {
                    "name":  "Dice",
                    "urlTemplate":  "https://www.dice.com/jobs?q={role}\u0026location={location}\u0026filters.postedDate=SEVEN",
                    "notes":  "US tech."
                },
                {
                    "name":  "ZipRecruiter",
                    "urlTemplate":  "https://www.ziprecruiter.com/jobs-search?search={role}\u0026location={location}\u0026days={days}",
                    "notes":  "US."
                },
                {
                    "name":  "Reed",
                    "urlTemplate":  "https://www.reed.co.uk/jobs/{role_slug}-jobs-in-{location_slug}",
                    "notes":  "UK."
                },
                {
                    "name":  "SEEK",
                    "urlTemplate":  "https://www.seek.com.au/{role_slug}-jobs/in-{location_slug}",
                    "notes":  "Australia / NZ."
                },
                {
                    "name":  "ATS discovery search",
                    "searchQuery":  "\"{role}\" \"{location}\" (site:boards.greenhouse.io OR site:jobs.lever.co OR site:jobs.ashbyhq.com OR site:apply.workable.com OR site:jobs.smartrecruiters.com)",
                    "notes":  "Web search that surfaces postings on company ATS pages. Most reliable web method; combine with firecrawl_search."
                }
            ]
